  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "// \u6700\u521D\u304B\u3089\u914D\u7F6E\u3055\u308C\u3066\u3044\u308B\u30B2\u30FC\u30E0\u30DE\u30CD\u30FC\u30B8\u30E3\u30FC\u306E\u30B9\u30AF\u30EA\u30D7\u30C8\r\n$.onStart(()
    => {\r\n    // \u6B66\u5668\u3092\u751F\u6210\u3059\u308B\u5074\u306E\u30A2\u30A4\u30C6\u30E0\uFF08\u89AA\u30DE\u30CD\u30FC\u30B8\u30E3\u30FC\uFF09\u306E\u300C\u8A2D\u8A08\u56F3\u306EID\uFF08TemplateId\uFF09\u300D\u306A\u3069\u3092\u4F7F\u3063\u3066\u3001\r\n   
    // \u30EF\u30FC\u30EB\u30C9\u5185\u306B\u3042\u308B\u305D\u306E\u30A2\u30A4\u30C6\u30E0\u3092\u691C\u7D22\u3059\u308B\u304B\u3001\r\n   
    // \u3042\u308B\u3044\u306F\u7279\u5B9A\u306E\u30E1\u30C3\u30BB\u30FC\u30B8\u3092\u5168\u4F53\uFF08Global\uFF09\u306B\u5411\u3051\u3066\u767A\u4FE1\u3057\u3066\u3001\u76F8\u624B\u306B\u81EA\u5206\uFF08$.itemHandle\uFF09\u3092\u767B\u9332\u3055\u305B\u307E\u3059\u3002\r\n   
    \r\n    // \u4F8B\uFF1AGlobal\u306B\u300C\u30B2\u30FC\u30E0\u30DE\u30CD\u30FC\u30B8\u30E3\u30FC\u304C\u8D77\u52D5\u3057\u305F\u3088\u300D\u3068\u81EA\u5206\u306E\u30CF\u30F3\u30C9\u30EB\u3092\u6DFB\u3048\u3066\u901A\u77E5\r\n   
    $.sendSignalCompat(\"global\", \"RegisterGameManager\");\r\n    // \u3082\u3057\u89AA\u30DE\u30CD\u30FC\u30B8\u30E3\u30FC\u306EID\u304C\u4E8B\u524D\u306B\u5206\u304B\u308B\u306A\u3089\u3001\u30D4\u30F3\u30DD\u30A4\u30F3\u30C8\u3067\u9001\u308B\u306E\u304C\u30D9\u30B9\u30C8\u3067\u3059\r\n});"
