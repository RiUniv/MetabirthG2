--- !u!114 &8334497410421309951
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6332008783871562257}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "const maxDistance = 30;\r\n$.onGrab((isGrab, isLeftHand, player) =>
    {\r\n  if (isGrab) {\r\n    $.setPlayerScript(player);\r\n    player.send(\"init_manager\",
    $.id);\r\n  }\r\n});\r\n\r\n$.onUse(isDown => {\r\n  if (!isDown) return;\r\n 
    let position = $.getPosition();\r\n  let direction = new Vector3(0, 0, 1).applyQuaternion($.getRotation());\r\n 
    let raycastResult = $.raycast(position, direction, maxDistance);\r\n\r\n\r\n 
    // \u76F4\u7DDA\u4E0A\u306B\u4F55\u3082\u898B\u3064\u304B\u3089\u306A\u304B\u3063\u305F\u5834\u5408\r\n 
    if (raycastResult == null) return;\r\n\r\n  let handle = raycastResult.handle;\r\n 
    if(handle == null) return;\r\n\r\n  if (handle.type == \"player\") {\r\n\t\t$.log(\"Player\");\r\n\t\thandle.send(\"damage\",
    { value: 40 });\r\n\t\treturn;\r\n\t}\r\n    \r\n});\r\n\r\n$.onReceive((messageType,
    arg, sender) => {\n  $.log(\"receive damage\");\r\n  if (messageType === \"Damaged\")
    {\r\n\r\n    $.sendSignalCompat(\"owner\", \"Damaged\"); \r\n    //$.setStateCompat(\"this\",
    \"HP_Display\", arg.hp);\r\n  }\r\n}, { player: true }); // PlayerScript\u304B\u3089\u306E\u30E1\u30C3\u30BB\u30FC\u30B8\u3092\u53D7\u3051\u53D6\u308B\u8A2D\u5B9A"
--- !u!114 &932741038317354650
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6332008783871562257}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: acb59730322447a7a13c40b87493e196, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.PlayerScript
  sourceCodeAsset: {fileID: 0}
  sourceCode: "let hp = 100;\r\n\r\nlet managerId = null;\r\n\r\n_.onReceive((messageType,
    arg, sender) => {\n\r\n    if (messageType === \"init_manager\") {\r\n       
    managerId = _.sourceItemId; \r\n    }\t\r\n\r\n    if (messageType === \"damage\")
    {\r\n        hp -= arg.value;\r\n        _.log(\"\u6B8B\u308AHP: \" + hp);\r\n\r\n       
    if (hp <= 0) {\r\n            _.respawn();\r\n            hp = 100;\r\n       
    }\r\n\r\n        if (managerId) {\r\n            try {\r\n                _.sendTo(managerId,
    \"Damaged\", true);\r\n            } catch (e) {\r\n                _.log(\"\u9001\u4FE1\u30A8\u30E9\u30FC:
    \" + e);\r\n            }\r\n        }\r\n    }\r\n});"
