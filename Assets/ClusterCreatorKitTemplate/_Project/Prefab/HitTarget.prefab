--- !u!114 &3774110886616396421
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5336545083212308420}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "$.onReceive((requestName, arg, sender) => {\n    $.log(\"receive request\");\n   
    // \u521D\u671F\u5316\n    if (!$.state.initialized) {\n        $.state.initialized
    = true;\n        $.state.hp = 30;\n    }\n   \n    // \u7279\u5B9A\u306ErequestName\u306E\u3068\u304D\u3060\u3051\u51E6\u7406\n   
    if (requestName == \"damage\") {\n        // \u5F15\u6570\u306E\u5024\u306E\u5206\u3060\u3051HP\u3092\u6E1B\u3089\u3059\n       
    let damage = arg.value;\n        let hp = $.state.hp - damage;\n\n\n        //
    HP\u304C0\u4EE5\u4E0B\u306B\u306A\u308B\u3068\u7834\u58CA\n        if (hp <=
    0) {\n            $.destroy();\n        }\n\n\n        $.state.hp = hp;\n   
    }\n});"
