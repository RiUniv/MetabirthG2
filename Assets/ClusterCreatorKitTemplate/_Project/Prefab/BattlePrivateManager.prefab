--- !u!114 &5114328710022157857
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6497718157366915462}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "$.onReceive((messageType, arg, sender) => {\r\n    if (messageType
    === \"init\") {\r\n        $.setPlayerScript(arg);\n        $.state.targetPlayer
    = arg;\r\n    }\r\n    if (messageType === \"Damaged\") {\r\n        $.sendSignalCompat(\"owner\", 
    \"Damaged\");\n        $.setStateCompat(\"owner\",  \"playerhp\",arg);\r\n   
    }\r\n}, { player: true });\n\n$.onUpdate((deltaTime) => {\n    let checkTimer
    = $.state.checkTimer ?? 0;\n    checkTimer += deltaTime;\n\n    if (checkTimer
    >= 10) {\n        CheckPlayerExistence();\n        checkTimer = 0;\n    }\n   
    $.state.checkTimer = checkTimer;\n});\n\nfunction CheckPlayerExistence() {\n   
    let target = $.state.targetPlayer;\n    \n    if (!target) return;\n\n    if
    (!target.exists()) {\n        $.destroy(); // \u30A2\u30A4\u30C6\u30E0\u81EA\u8EAB\u3092\u7834\u68C4
    \n    }\n}\r\n"
--- !u!114 &6944015005593344472
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6497718157366915462}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: acb59730322447a7a13c40b87493e196, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.PlayerScript
  sourceCodeAsset: {fileID: 0}
  sourceCode: "const MaxHp = 100;\nlet hp = MaxHp;\nlet managerId =  _.sourceItemId;\n\n_.onReceive((messageType,
    arg, sender) => {\n    if (messageType === \"damage\") {\n        hp -= arg.value;\n       
    _.log(\"\u6B8B\u308AHP: \" + hp);\n\n        if (hp <= 0) {\n            _.respawn();\n           
    hp = MaxHp;\n        }\n\n        if (managerId) {\n            try {\n               
    _.sendTo(managerId, \"Damaged\", hp);\n            } catch (e) {\n               
    _.log(\"\u9001\u4FE1\u30A8\u30E9\u30FC: \" + e);\n            }\n        }\n   
    }\n});"
