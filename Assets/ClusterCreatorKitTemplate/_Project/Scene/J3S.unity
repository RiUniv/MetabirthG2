  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 5022602860645237092, guid: d4d6a007a619e9341bbdbfbd4a2a3b38,
    type: 3}
  sourceCode: "const gameManagerId = $.worldItemReference(\"GameManager\");\nconst
    switchButtonId = $.worldItemReference(\"SwitchButton\");\n\n$.onInteract(() =>
    {\r\n    if (switchButtonId) {\n        switchButtonId.send(\"ResetReadyStatus\",
    null);\n        gameManagerId.send(\"endMatch\",null);\n    }\r\n});"
